{
    "compilerOptions":{
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution":"nodenext",
        "lib":["ES2022"],
        "outDir": "./dist",
        "rootDir": "/src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"]
}